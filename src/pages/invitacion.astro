---
import BaseLayout from '../layouts/BaseLayout.astro';
import { InvitationCelebration } from '../components/InvitationExperience.jsx';
import { invitationConfig } from '../lib/invitation.js';
import '../styles/invitation.css';
---

<BaseLayout title={`Nuestra revelación de género · ${invitationConfig.dateLabel}`} description={`Te esperamos para compartir una pequeña gran sorpresa el ${invitationConfig.dateLabel}.`} preloadImages={[{ href: '/assets/invitation-background-mobile-soft.webp', media: '(max-width: 600px)' }, { href: '/assets/invitation-background-desktop-soft.webp', media: '(min-width: 601px)' }, { href: '/assets/envelope-stationery-open.webp' }]}>
  <InvitationCelebration client:load />
</BaseLayout>
