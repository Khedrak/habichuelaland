---
export const prerender = true;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Abriendo tu invitación</title>
  </head>
  <body>
    <p>Tu invitación está aquí: <a id="invitation-redirect" href="/">continuar a la invitación</a>.</p>
    <script is:inline>
      const destination = '/' + window.location.search + window.location.hash;
      document.getElementById('invitation-redirect').href = destination;
      window.location.replace(destination);
    </script>
  </body>
</html>
