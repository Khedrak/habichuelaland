---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/invitation.css';
---

<BaseLayout title="No encontramos tu invitación" description="El enlace de invitación no es válido o está incompleto.">
  <main class="invitation-unavailable">
    <picture class="unavailable-background" aria-hidden="true">
      <source media="(min-width: 601px)" srcset="/assets/invitation-background-desktop-soft.webp" />
      <img src="/assets/invitation-background-mobile-soft.webp" alt="" fetchpriority="high" />
    </picture>

    <img class="unavailable-cloud unavailable-cloud--left" src="/assets/cloud.webp" alt="" aria-hidden="true" />
    <img class="unavailable-cloud unavailable-cloud--right" src="/assets/cloud.webp" alt="" aria-hidden="true" />
    <img class="unavailable-star unavailable-star--one" src="/assets/star.webp" alt="" aria-hidden="true" />
    <img class="unavailable-star unavailable-star--two" src="/assets/star.webp" alt="" aria-hidden="true" />

    <section class="unavailable-message" aria-labelledby="unavailable-title">
      <span class="unavailable-eyebrow">Una invitación muy especial</span>
      <h1 id="unavailable-title">No encontramos tu <em>invitación</em></h1>
      <p>Este enlace parece incompleto. Pídele a quien te invitó que te reenvíe tu invitación personalizada.</p>
      <img class="unavailable-bear" src="/assets/teddy-curious.webp" width="1024" height="1024" alt="Un osito curioso buscando tu invitación" fetchpriority="high" />
    </section>
  </main>
</BaseLayout>

<style>
  .invitation-unavailable {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: 100svh;
    place-items: center;
    overflow: hidden;
    padding: max(28px, env(safe-area-inset-top)) 20px max(28px, env(safe-area-inset-bottom));
    background: radial-gradient(ellipse at 50% 42%, #fffaf1e6 0%, #faf4e8d9 54%, #f5ebd9e8 100%);
  }

  .unavailable-background { position: absolute; z-index: -2; inset: 0; opacity: 0.72; pointer-events: none; }
  .unavailable-background::after { position: absolute; inset: 0; background: linear-gradient(90deg, #fffaf144, #fffaf188 50%, #fffaf144); content: ''; }
  .unavailable-background img { width: 100%; height: 100%; object-fit: cover; }
  .unavailable-message {
    position: relative;
    width: min(100%, 520px);
    padding: 24px 12px 0;
    text-align: center;
    animation: unavailable-message-in 700ms ease-out both;
  }
  .unavailable-eyebrow { display: inline-block; margin-bottom: 14px; color: #9a7548; font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; }
  .unavailable-message h1 { max-width: 14ch; margin-inline: auto; color: #63452e; font-size: clamp(2rem, 7vw, 3.15rem); line-height: 1.16; text-shadow: 0 1px 12px #fffaf0ad; }
  .unavailable-message h1 em { display: inline-block; }
  .unavailable-message p { max-width: 38ch; margin: 18px auto 10px; color: #80654b; font-size: clamp(1rem, 3.8vw, 1.12rem); line-height: 1.75; text-shadow: 0 1px 10px #fffaf0bf; }
  .unavailable-bear { position: relative; top: 14px; width: clamp(170px, 48vw, 236px); height: auto; margin: 6px auto -14px; object-fit: contain; filter: drop-shadow(0 10px 12px #704a2521); animation: unavailable-bear-float 4.8s ease-in-out 700ms infinite; }
  .unavailable-cloud, .unavailable-star { position: absolute; z-index: -1; pointer-events: none; user-select: none; }
  .unavailable-cloud { width: clamp(120px, 28vw, 230px); opacity: 0.8; animation: unavailable-cloud-float 8s ease-in-out infinite; }
  .unavailable-cloud--left { top: 13%; left: -34px; }
  .unavailable-cloud--right { right: -38px; bottom: 12%; animation-delay: -3.5s; }
  .unavailable-star { width: clamp(24px, 5vw, 38px); opacity: 0.9; animation: unavailable-star-spin 12s linear infinite; }
  .unavailable-star--one { top: 18%; right: 18%; }
  .unavailable-star--two { bottom: 20%; left: 15%; width: clamp(18px, 3.5vw, 28px); animation-delay: -5s; }

  @keyframes unavailable-message-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes unavailable-bear-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-7px); } }
  @keyframes unavailable-cloud-float { 0%, 100% { transform: translate3d(0, 0, 0); } 50% { transform: translate3d(8px, -9px, 0); } }
  @keyframes unavailable-star-spin { to { rotate: 360deg; } }

  @media (prefers-reduced-motion: reduce) {
    .unavailable-message, .unavailable-bear, .unavailable-cloud, .unavailable-star { animation: none; }
  }
  @media (max-width: 480px) {
    .unavailable-eyebrow { font-size: 0.7rem; }
  }
</style>
